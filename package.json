{
  "name": "crtgrphr",
  "version": "1.2.0",
  "description": "Cartographer: grounded, auto-laid-out, editable system maps.",
  "main": "./out/main/index.js",
  "author": "Sarthak-47",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.cli.json",
    "package": "node scripts/dist.mjs --dir",
    "dist": "node scripts/dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "electron-vite build && node tests/e2e/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "icon": "node scripts/make-icon.mjs",
    "site:data": "vite-node --config vitest.config.ts scripts/site-data.ts",
    "site:serve": "node scripts/serve-site.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "bench": "vite-node --config vitest.config.ts scripts/bench.ts",
    "cli": "node action/dist/crtgrphr.mjs",
    "map": "node action/dist/crtgrphr.mjs scan . --out docs/architecture.crtgrphr --mermaid docs/architecture.md --svg docs/architecture.svg"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.3.5",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.9.3",
    "fast-check": "^4.10.2",
    "nanoid": "^5.0.9",
    "playwright-core": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.38.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vite-node": "^5.3.0",
    "vitest": "^5.1.0",
    "zustand": "^5.0.2"
  },
  "homepage": "https://github.com/Sarthak-47/crtgrphr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sarthak-47/crtgrphr.git"
  }
}
